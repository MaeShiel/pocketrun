/bin/

# Dart/Flutter build state (the Flutter projects also have their own .gitignore)
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies

# Android local state
local.properties
.gradle/
*.jks
*.keystore
key.properties

# Editors
.idea/
*.iml
.vscode/
